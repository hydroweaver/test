# Only two things are actually required to get this running: pick one provider
# key below, and (once deployed) set the Twilio vars. Everything else is optional
# and has a sane default - don't bother filling it in for a quick test.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- WhatsApp (Twilio) - required once you wire up the webhook ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your public URL (e.g. the one Railway gives you). Only used to check that
# webhook calls really came from Twilio - leave it blank and it just skips that check.
PUBLIC_BASE_URL=

# --- Everything below is optional - defaults are fine for a quick test ---

# Admin page (/admin) login. Defaults to admin/admin if left blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Encrypts API keys pasted into the admin page. Auto-generated and stored next
# to the database if left blank - only set this yourself if you want it to
# survive without a Railway Volume.
SETTINGS_ENCRYPTION_KEY=

ANTHROPIC_DEFAULT_MODEL=claude-opus-5
OPENAI_DEFAULT_MODEL=gpt-5
GEMINI_DEFAULT_MODEL=gemini-3-flash
DB_PATH=./data/app.db
COMPANY_NAME=Route Mobile
MAX_TOOL_TURNS=3

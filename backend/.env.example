# Copy this file to .env and fill in the keys for whichever providers you want to use.
# You don't need all three - only set the ones you plan to call.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model used when a request doesn't specify one.
ANTHROPIC_DEFAULT_MODEL=claude-opus-5
OPENAI_DEFAULT_MODEL=gpt-5
GEMINI_DEFAULT_MODEL=gemini-3-flash

# Provider keys are read from these env vars only (set them in Railway - they
# survive redeploys, the database does not unless you attach a Volume).

OPENAI_API_KEY=
GEMINI_API_KEY=

# --- WhatsApp (Twilio) ---
# Replies are sent asynchronously via Twilio's API (no webhook time limit), so these
# are REQUIRED - without them the bot can't reply at all. It warns at startup and
# every usage row logs "send failed". They also let it RECEIVE images and voice notes.
#
# The account SID is ALWAYS needed and is always the one starting with AC... - it
# identifies the account, it is not a credential on its own.
TWILIO_ACCOUNT_SID=
# Then ONE of the two credential pairs below:
#  (a) the account Auth Token, or
#  (b) an API Key SID (SK...) + its Secret - what the console gives you when you
#      create an API key. Leave TWILIO_AUTH_TOKEN blank if you use these.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The WhatsApp number replies are sent FROM. Sandbox number is +14155238886.
TWILIO_WHATSAPP_NUMBER=
# Your public URL (e.g. the one Railway gives you). Required for sending images and
# voice notes (Twilio fetches them from this host), and used to verify webhook calls.
PUBLIC_BASE_URL=

# --- Everything below is optional - defaults are fine for a quick test ---

# Admin page (/admin) login form. Defaults to admin/admin if left blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: signs the admin session cookie. Defaults to a value derived from
# ADMIN_PASSWORD, which means changing the password logs out existing sessions.
ADMIN_SESSION_SECRET=

OPENAI_DEFAULT_MODEL=gpt-5
GEMINI_DEFAULT_MODEL=gemini-3-flash
DB_PATH=./data/app.db
COMPANY_NAME=Sharma Kirana Store
MAX_TOOL_TURNS=3

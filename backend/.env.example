# Copy this file to .env and fill in the keys for whichever providers you want to use.
# You don't need all three - only set the ones you plan to call.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model used when a request doesn't specify one.
ANTHROPIC_DEFAULT_MODEL=claude-opus-5
OPENAI_DEFAULT_MODEL=gpt-5
GEMINI_DEFAULT_MODEL=gemini-3-flash

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The public HTTPS URL this app is reachable at (your Railway URL, or an ngrok URL
# while testing locally). Used to validate that webhook calls really came from Twilio.
PUBLIC_BASE_URL=

# --- Admin page (protects /admin/*) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Encrypts API keys you paste into the admin page before storing them in SQLite.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# --- Misc ---
DB_PATH=./data/app.db
COMPANY_NAME=Route Mobile
MAX_TOOL_TURNS=3
